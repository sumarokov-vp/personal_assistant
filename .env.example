BOT_TOKEN=
# Telegram ID владельца: бот слышит только его и только в личном чате; без него не стартует
OWNER_TELEGRAM_ID=
BOT_DB_URL=postgres://user:password@localhost:5432/personal_assistant?sslmode=disable
REDIS_URL=redis://localhost:6379/4
AI_DB_URL=postgres://user:password@localhost:5432/personal_assistant?sslmode=disable&options=-csearch_path%3Dai
CLAUDE_CODE_OAUTH_TOKEN=
AI_MODEL=claude-sonnet-5
# Effort CLI Claude Code: low|medium|high|xhigh; прод — low (deploy/up.sh), без переменной — умолчание CLI
CLAUDE_CODE_EFFORT_LEVEL=low
OWNER_TIMEZONE=Asia/Almaty
VOICE_RECOGNITION_URL=http://localhost:8000
VOICE_RECOGNITION_API_KEY=
VOICE_RECOGNITION_MODE=http
WHISPER_MODEL=small
LOG_LEVEL=INFO
# Память ассистента: local (дефолт) — файлы в MEMORY_DIR (дефолт ~/.local/share/personal_assistant/memory),
# wiki — служебные страницы вики obsidian_wiki (нужен WIKI_DIR)
MEMORY_STORAGE=local
MEMORY_DIR=
# Вики: локальная копия obsidian_wiki; пустой каталог — бот сам сделает clone. Без WIKI_DIR инструментов wiki_* нет
WIKI_DIR=
WIKI_REMOTE_URL=git@github.com:sumarokov-vp/obsidian_wiki.git
# Необязательная: deploy key obsidian_wiki (файл 0600); без неё git берёт ssh-ключи/агент пользователя
WIKI_SSH_KEY_PATH=
DROPBOX_ROOT=
ATTACHMENTS_S3_ENDPOINT=https://fra1.digitaloceanspaces.com
ATTACHMENTS_S3_BUCKET=sumarokov-pa-attachments
ATTACHMENTS_S3_REGION=fra1
ATTACHMENTS_S3_ACCESS_KEY=
ATTACHMENTS_S3_SECRET_KEY=
# Сервис дел (assistant_cases): обе или ни одной; без них инструментов дел нет
CASES_API_URL=http://localhost:8000
CASES_API_KEY=
TODOIST_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
